# StegoCyber Backend Environment Configuration
PORT=8000
HOST=127.0.0.1
MAX_UPLOAD_SIZE=104857600 # 100 MB

# Custom path to ffmpeg executable if not in system PATH:
# FFMPEG_PATH=C:\Program Files\ffmpeg\bin\ffmpeg.exe

# -------------------------------------------------------------
# REAL SMS GATEWAY CONFIGURATION (for cellular phone delivery)
# -------------------------------------------------------------
# Option 1: Twilio (Global SMS)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+1234567890

# Option 2: Fast2SMS (India numbers +91)
# FAST2SMS_API_KEY=your_fast2sms_api_key

# Option 3: Custom SMS Webhook
# SMS_WEBHOOK_URL=https://your-domain.com/api/send-sms
